<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.rwojsznis.Fastsonic</id>
  <name>Fastsonic</name>
  <summary>A native client for self-hosted music servers</summary>
  <developer id="io.github.rwojsznis">
    <name>Rafal Wojsznis</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>
      A Subsonic client written in Rust with no browser engine. It starts
      in well under a second and streams music from your own server for
      playback on this computer.
    </p>
    <p>
      Browse and search your library, edit playlists, manage the queue,
      and view lyrics. It also has keyboard shortcuts, media-key support,
      background playback, and a mini player for classic Winamp skins.
      It connects directly to the music server you configure.
    </p>
  </description>
  <launchable type="desktop-id">io.github.rwojsznis.Fastsonic.desktop</launchable>
  <url type="homepage">https://github.com/rwojsznis/fastsonic</url>
  <url type="bugtracker">https://github.com/rwojsznis/fastsonic/issues</url>
  <url type="help">https://github.com/rwojsznis/fastsonic/blob/main/docs/_guide/getting-started.md</url>
  <url type="vcs-browser">https://github.com/rwojsznis/fastsonic</url>
  <screenshots>
    <screenshot type="default">
      <caption>A playlist, with the queue open and a track playing</caption>
      <image>https://raw.githubusercontent.com/rwojsznis/fastsonic/main/docs/screenshot.png</image>
    </screenshot>
    <screenshot>
      <caption>The mini player wearing the built-in Winamp skin</caption>
      <image>https://raw.githubusercontent.com/rwojsznis/fastsonic/main/docs/assets/images/winamp.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#1ed760</color>
    <color type="primary" scheme_preference="dark">#144a2a</color>
  </branding>
  <content_rating type="oars-1.1" />
  <requires>
    <display_length compare="ge">760</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <!--
    One entry per Fastsonic tag, newest first, added in the same change that
    pushes the tag. The versions before this were upstream Fastpotify's and
    were never published by this fork.
  -->
  <releases>
    <release version="0.6.0" date="2026-09-03">
      <url>https://github.com/rwojsznis/fastsonic/releases/tag/v0.6.0</url>
    </release>
  </releases>
</component>
